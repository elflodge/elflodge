{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  // Better Auth uses Node's AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "RUNNER_CONNECTION", "class_name": "RunnerConnection" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunnerConnection"] }],
  // The dashboard's build, served under its base path, which `apps/dashboard/vite.config.ts` sets
  // as its `base`, before the Worker runs (ADR 0043). A navigation to a path with no file of its
  // own gets the app shell, `index.html`; any other request with no file reaches the Worker.
  "assets": {
    "directory": "../dashboard/dist/client",
    "base_path": "/dashboard/",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // A placeholder: before deploying, replace it with the ID of a Hyperdrive configuration with
      // caching disabled (the hub's README says why). Locally, Wrangler reads the connection string
      // from CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      "id": "00000000000000000000000000000000",
    },
  ],
  // The sweep of uploads and content nothing uses any longer, at the top of every hour in UTC, as
  // Cron Triggers run; the Node hub's `src/main.ts` sweeps on the same expression.
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    // The request header carrying the client's IP address, for Better Auth's rate limits.
    "CLIENT_IP_HEADER": "cf-connecting-ip",
  },
  "secrets": {
    // `BETTER_AUTH_SECRET` signs sessions; generate one with `openssl rand -base64 32`.
    // `HUB_URL` is the hub's public URL: Better Auth's base URL, for its links, its trusted origin
    // and whether cookies are `Secure`, and the address anything else gives out. It is not secret,
    // but Wrangler declares required settings only here, and a default would silently give wrong
    // links and cookies. Locally, see `.dev.vars.example`.
    "required": ["BETTER_AUTH_SECRET", "HUB_URL"],
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
}
