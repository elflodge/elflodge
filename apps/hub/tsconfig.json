{
  "compilerOptions": {
    "target": "esnext",
    // Only runtimes we choose run the hub, Node 26 and workerd (ADR 0024).
    "lib": ["esnext"],
    // `esnext` for import attributes, with which the hub reads its version from its package.json.
    "module": "esnext",
    "resolveJsonModule": true,
    // The extension adapter's source, which the tests' Runner loads, rather than its build.
    "customConditions": ["@elflodge/source"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["./worker-configuration.d.ts", "node"]
  }
}
