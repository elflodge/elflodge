# Workers Static Assets match paths under the dashboard's Vite base. The Node hub sets the same
# Cache-Control in apps/hub/src/node/dashboard.ts.
# Vite names files under assets/ by content hash, so browsers can cache them for a year.
# For a missing asset, Sec-Fetch-Mode selects the shell from Static Assets or a 404 from the Worker,
# so caches must distinguish request modes at the same URL (RFC 9110, 12.5.5).
/dashboard/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Sec-Fetch-Mode
