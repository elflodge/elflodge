# Workers Static Assets match paths under the dashboard's Vite base. The Node hub sets the same
# Cache-Control in apps/hub/src/node/dashboard.ts.
# Vite names files under assets/ by content hash, so browsers can cache them for a year.
# Cloudflare's SPA fallback serves the dashboard HTML when a browser opens a missing asset URL.
# A script request to the same URL gets a 404 from the Worker. Both responses set
# Vary: Sec-Fetch-Mode so caches keep them separate (RFC 9110, 12.5.5).
/dashboard/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Sec-Fetch-Mode
