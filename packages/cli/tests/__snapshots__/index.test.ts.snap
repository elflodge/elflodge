              "negate": false,
              "optional": false,
              "required": true,
              "variadic": false,
            },
          ],
          "usage": "[options]",
        },
        {
          "arguments": [],
          "commands": [],
          "description": "Deletes a finished job and answers with the job as it now reads. Its content goes from the hub at once, its Input files' Blobs included unless an upload under seven days old still holds them, and from its host once its Runner has deleted its journal and Workspace; until then the job reads without its content, with \`deletedAt\` and a waiting \`delete\`, and then as not found. Its Usage record stays, and so does its Batch, with the agent's instructions and Output contract. An unfinished job is refused: cancel it first.",
          "name": "delete",
          "options": [
            {
              "attributeName": "id",
              "description": "The job's ID.; Format: uuid; Pattern: ^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "flags": "--id <string>",
