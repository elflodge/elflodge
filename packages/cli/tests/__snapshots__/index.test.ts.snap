          ],
          "usage": "[options]",
        },
        {
          "arguments": [],
          "commands": [],
          "description": "Reads a job's events, oldest first unless \`order\` is desc. With \`order\` desc and \`limit\` 2 returning IDs 98 and 93, pass \`after\` 93 in the same order for older events, and \`after\` 98 in ascending order to follow new ones, or \`after\` 0 if the first page was empty. \`hasMore\` says whether more events are stored in that order. When following, read again at once while \`hasMore\` is true, or after a few seconds otherwise, and stop when an ascending page has a final \`status\` and \`hasMore\` is false. The Events have a 1 MiB budget. The first eligible event is always included, even if it alone exceeds the budget. Events lost with a host may be missing.",
          "name": "events",
          "options": [
            {
              "attributeName": "id",
              "description": "The job's ID.; Format: uuid; Pattern: ^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "flags": "--id <string>",
              "name": "id",
              "negate": false,
              "optional": false,
              "required": true,
              "variadic": false,
            },
            {
              "attributeName": "order",
              "choices": [
                "asc",
                "desc",
              ],
              "description": "Event ID order, oldest first (asc, the default) or newest first (desc).",
              "flags": "--order [string]",
              "name": "order",
              "negate": false,
              "optional": true,
              "required": false,
              "variadic": false,
            },
            {
              "attributeName": "after",
              "description": "Continue past this Event ID in the requested order. Omit or use 0 to start at the first Event in that order.; non-negative",
              "flags": "--after [integer]",
              "name": "after",
              "negate": false,
              "optional": true,
              "required": false,
              "variadic": false,
            },
            {
              "attributeName": "limit",
              "defaultValue": 100,
              "description": "At most this many events in the page, 100 by default.; Minimum: 1; Maximum: 100",
              "flags": "--limit [integer]",
              "name": "limit",
              "negate": false,
              "optional": true,
              "required": false,
              "variadic": false,
