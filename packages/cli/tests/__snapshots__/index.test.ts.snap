        {
          "arguments": [],
          "commands": [],
          "description": "Lists jobs, newest first, in pages of at most \`limit\`. Filters combine: a job is listed when it has one of the \`status\` values given, every label in \`labels\`, the \`batchId\`, \`customId\` and \`runnerId\` given, and \`statusUnknown\` present or absent as asked. Read the next page with the same filters and \`after\` set to the last job's \`id\`, while the page says \`hasMore\`. A listed job has no \`output\`, failure \`message\` or \`activity\`: read the job for those.",
          "name": "list",
          "options": [
            {
              "attributeName": "status",
              "choices": [
                "queued",
                "running",
                "paused",
                "succeeded",
                "failed",
                "cancelled",
              ],
              "description": "Type: string Any of the given statuses. Omit the filter to include every status. An empty list also includes every status. array",
              "flags": "--status [values...]",
              "name": "status",
              "negate": false,
              "optional": true,
              "required": false,
              "variadic": true,
            },
            {
              "attributeName": "labels",
              "description": "Label key/value pairs that must all match.; Property names: {"type":"string","pattern":"^(?:(?=.{1,253}\\\\/)[a-z0-9](?:[\\\\-a-z0-9]*[a-z0-9])?(?:\\\\.[a-z0-9](?:[\\\\-a-z0-9]*[a-z0-9])?)*\\\\/)?[A-Za-z0-9](?:[\\\\-_.A-Za-z0-9]{0,61}[A-Za-z0-9])?$"}",
