              "flags": "--batch-id [string]",
              "name": "batch-id",
              "negate": false,
              "optional": true,
              "required": false,
              "variadic": false,
            },
            {
              "attributeName": "customId",
              "description": "The job's own \`customId\`, which is unique in its Batch, so without \`batchId\` it may match a job in each of several Batches.; Min length: 1; Max length: 255",
              "flags": "--custom-id [string]",
              "name": "custom-id",
              "negate": false,
              "optional": true,
