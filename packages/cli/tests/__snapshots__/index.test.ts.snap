              "description": "\`true\` for only the jobs whose status the hub cannot confirm now (\`statusUnknown\`), \`false\` for only the others; any job when absent.",
              "flags": "--status-unknown [boolean]",
              "name": "status-unknown",
              "negate": false,
              "optional": true,
              "required": false,
              "variadic": false,
            },
            {
              "attributeName": "after",
              "description": "The last job's ID on the previous page, to read on after it.; Format: uuid; Pattern: ^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
